# Copy to .env.local for local development. Set these in the hosting provider's
# environment settings for deployment. Never commit real credentials.
MONGODB_URI=

# Required only when the admins collection is empty. Existing credentials are
# stored in MongoDB; changing these values does not reset an existing account.
ADMIN_ID=
ADMIN_PASSWORD=

# Required for uploading admin-managed images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
